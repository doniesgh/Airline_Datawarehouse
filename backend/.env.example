# Copy this file to .env and fill in the values. .env is git-ignored.

# Chatbot / Travel Concierge (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Email OTP (Gmail App Password, NOT your normal password)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# MongoDB (only needed for face login/verify)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=tunisys
