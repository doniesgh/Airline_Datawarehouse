          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;USE [STAGING_DB];&#xA;TRUNCATE TABLE dbo.stg_airline_satisfaction;&#xA;TRUNCATE TABLE dbo.stg_flight_activity;&#xA;TRUNCATE TABLE dbo.stg_customer_loyalty;&#xA;TRUNCATE TABLE dbo.stg_date;&#xA;IF EXISTS (SELECT 1 FROM sys.indexes WHERE name=N'IX_stg_sat_id')&#xA;DROP INDEX IX_stg_sat_id ON dbo.stg_airline_satisfaction;&#xA;IF EXISTS (SELECT 1 FROM sys.indexes WHERE name=N'IX_stg_activity_loyalty')&#xA;DROP INDEX IX_stg_activity_loyalty ON dbo.stg_flight_activity;&#xA;IF EXISTS (SELECT 1 FROM sys.indexes WHERE name=N'IX_stg_customer_loyalty')&#xA;DROP INDEX IX_stg_customer_loyalty ON dbo.stg_customer_loyalty;&#xA;IF EXISTS (SELECT 1 FROM sys.indexes WHERE name=N'IX_stg_date_value')&#xA;DROP INDEX IX_stg_date_value ON dbo.stg_date;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Rebuild_Staging"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{BB000011-0000-4000-8000-BB0000000001}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Rebuild_Staging"
      DTS:TaskContact="Execute SQL Task"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{BB000001-0000-4000-8000-BB0000000001}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;CREATE NONCLUSTERED INDEX IX_stg_sat_id&#xA;ON dbo.stg_airline_satisfaction (ID)&#xA;INCLUDE (TypeOfTravel, Class, Satisfaction_Flag, AvgServiceScore)&#xA;WITH (FILLFACTOR=95);&#xA;CREATE NONCLUSTERED INDEX IX_stg_activity_loyalty&#xA;ON dbo.stg_flight_activity (LoyaltyNumber)&#xA;INCLUDE (Year, Month, TotalFlights, Distance, PointsAccumulated)&#xA;WITH (FILLFACTOR=95);&#xA;CREATE NONCLUSTERED INDEX IX_stg_customer_loyalty&#xA;ON dbo.stg_customer_loyalty (LoyaltyNumber)&#xA;INCLUDE (LoyaltyCard, Country, Province, City, PostalCode)&#xA;WITH (FILLFACTOR=95);&#xA;CREATE NONCLUSTERED INDEX IX_stg_date_value&#xA;ON dbo.stg_date (DateValue)&#xA;INCLUDE (StartOfYear, StartOfQuarter, StartOfMonth)&#xA;WITH (FILLFACTOR=95);&#xA;UPDATE STATISTICS dbo.stg_airline_satisfaction WITH SAMPLE 50 PERCENT;&#xA;UPDATE STATISTICS dbo.stg_flight_activity WITH SAMPLE 50 PERCENT;&#xA;UPDATE STATISTICS dbo.stg_customer_loyalty WITH SAMPLE 50 PERCENT;&#xA;UPDATE STATISTICS dbo.stg_date WITH SAMPLE 50 PERCENT;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Validate_Staging"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{BB000012-0000-4000-8000-BB0000000001}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Validate_Staging"
      DTS:TaskContact="Execute SQL Task"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{BB000001-0000-4000-8000-BB0000000001}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;DECLARE @sat INT,@act INT,@cust INT,@dt INT;&#xA;SELECT @sat=COUNT(*) FROM dbo.stg_airline_satisfaction;&#xA;SELECT @act=COUNT(*) FROM dbo.stg_flight_activity;&#xA;SELECT @cust=COUNT(*) FROM dbo.stg_customer_loyalty;&#xA;SELECT @dt=COUNT(*) FROM dbo.stg_date;&#xA;IF @sat=0 RAISERROR(N'STAGING VALIDATION FAILED: stg_airline_satisfaction is empty!',16,1);&#xA;IF @act=0 RAISERROR(N'STAGING VALIDATION FAILED: stg_flight_activity is empty!',16,1);&#xA;IF @cust=0 RAISERROR(N'STAGING VALIDATION FAILED: stg_customer_loyalty is empty!',16,1);&#xA;IF @dt=0 RAISERROR(N'STAGING VALIDATION FAILED: stg_date is empty!',16,1);&#xA;PRINT CONCAT(N'Staging OK | Satisfaction:',@sat,N' Activity:',@act,N' Customer:',@cust,N' Date:',@dt);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
