        <pipeline version="1">
          <components>

            <!-- OLE DB Source -->
            <component refId="Package\DFT_FACT_SATISFACTION\SRC_stg_satisfaction"
              componentClassID="{657B7EBE-0A54-4C0E-A80E-7A5BD9886C25}"
              name="SRC_stg_satisfaction" usesDispositions="true" version="7">
              <properties>
                <property dataType="System.Int32"  name="AccessMode">2</property>
                <property dataType="System.String" name="SqlCommand">SELECT
    ISNULL((SELECT TOP 1 t.SK_Travel
            FROM DWH_DB.dbo.DIM_TRAVEL t
            WHERE t.TypeOfTravel = ISNULL(s.TypeOfTravel,N'Unknown')
              AND t.Class        = ISNULL(s.Class,N'Unknown')
              AND t.SK_Travel &gt; 0), -1) AS SK_Travel,
    s.Gender, s.CustomerType, s.Age, s.FlightDistance,
    s.DepartureDelay, s.ArrivalDelay,
    s.TimeConvenience, s.OnlineBooking, s.CheckinService, s.OnlineBoarding,
    s.GateLocation, s.OnboardService, s.SeatComfort, s.LegRoom,
    s.Cleanliness, s.FoodAndDrink, s.InFlightService, s.InFlightWifi,
    s.InFlightEntertainment, s.BaggageHandling,
    s.AvgServiceScore, s.Satisfaction, s.Satisfaction_Flag
FROM dbo.stg_airline_satisfaction s</property>
                <property dataType="System.Int32"  name="DefaultCodePage">1252</property>
                <property dataType="System.Boolean" name="AlwaysUseDefaultCodePage">false</property>
